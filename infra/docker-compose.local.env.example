# `infra` 에서: cp docker-compose.local.env.example .env  후 IP 만 수정
#
# 도커를 띄우는 PC(맥/리눅스)의 LAN 주소. 라즈베리파이에서
#   ping 192.168.0.5
# 가 되는 IP와 같게 하세요. (WIFI/유선, 방화벽 9094·3000 열기)
KAFKA_ADVERTISED_HOST=192.168.0.5

# (선택) Next 대시보드가 다른 머신/포트에 있을 때
# CORS_ORIGIN=http://192.168.0.5:3001
# FRONTEND_REDIRECT_URI=http://192.168.0.5:3001/dashboard
