# EC2 — docker-compose + nginx(호스트) 리버스 프록시
# nginx 는 127.0.0.1:3000 (API) · 127.0.0.1:3001 (Next) 을 proxy_pass (compose 가 loopback 을 씀)

# 퍼블릭 IP (Kafka 9094, Pi/edge) — :9094
EC2_PUBLIC_HOST=1.2.3.4

# **브라우저·Next·CORS·Fitbit에 보이는 URL (nginx 443, 포트 생략 권장)**
#  한 도메인 + 경로로 나누면 보통 둘 다 같은 orgin:
#    API_BASE_URL=https://overtraining.kro.kr
#    DASHBOARD_BASE_URL=https://overtraining.kro.kr
#  api / app 으로 서브도메인 쪼개면:
#    API_BASE_URL=https://api.overtraining.kro.kr
#    DASHBOARD_BASE_URL=https://app.overtraining.kro.kr
API_BASE_URL=https://overtraining.kro.kr
DASHBOARD_BASE_URL=https://overtraining.kro.kr

# (Fitbit 개발자 콘솔) Callback URL = ${API_BASE_URL}/auth/fitbit/callback
#  엣지: EC2_API_BASE=${API_BASE_URL}

MYSQL_ROOT_PASSWORD=changeme
JWT_SECRET=your-random-32-char-secret-here
FITBIT_CLIENT_ID=your-fitbit-client-id
FITBIT_CLIENT_SECRET=your-fitbit-client-secret
EDGE_API_KEY_PEPPER=your-random-pepper
SEED_EDGE_API_KEY=pi-01-initial-key
