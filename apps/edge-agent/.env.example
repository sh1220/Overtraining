# Edge Agent (Raspberry Pi) — EC2/운영
# KAFKA_BROKERS = EC2의 infra/.env EC2_PUBLIC_HOST:9094 과 동일. 로그에 broker: localhost:9094 면
#   EC2에서 EC2_PUBLIC_HOST 를 공인 DNS/IP로 바꾼 뒤 kafka 컨테이너 재시작 (localhost 쓰면 안 됨)
KAFKA_BROKERS=overtraining.kro.kr:9094
EC2_API_BASE=https://overtraining.kro.kr
EDGE_API_KEY=pi-01-initial-key
DEVICE_ID=pi-01
USER_ID=1
MOCK_SENSOR=true
MOCK_FITBIT=true
