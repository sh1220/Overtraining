# Edge Agent (Raspberry Pi) — EC2/운영
# KAFKA_BROKERS = EC2의 infra/.env EC2_PUBLIC_HOST:9094 과 동일. 로그에 broker: localhost:9094 면
#   EC2에서 EC2_PUBLIC_HOST 를 공인 DNS/IP로 바꾼 뒤 kafka 컨테이너 재시작 (localhost 쓰면 안 됨)
KAFKA_BROKERS=overtraining.kro.kr:9094
EC2_API_BASE=https://overtraining.kro.kr
EDGE_API_KEY=pi-01-initial-key
DEVICE_ID=pi-01
# Fitbit 토큰 API(/api/edge/fitbit-token)용. 심박·리스크는 Kafka HR 메시지에 device_id도 붙이고,
#  EC2 MySQL edge_devices.user_id(디바이스에 연결된 유저)로 라우팅 — 대시보드 유저와 맞추려면
#  POST /api/edge/register { device_id, user_id } 로 등록하거나 DB에서 user_id 갱신
USER_ID=1
MOCK_SENSOR=true
MOCK_FITBIT=true
# (선택) 심박/토큰 루프(ms) ≥1000. 생략 시: MOCK_FITBIT=true → 3초, false → 60초(429·쿼터)
# HR_POLL_INTERVAL_MS=60000
