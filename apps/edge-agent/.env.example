# Edge Agent (Raspberry Pi) 환경변수
# 데스크톱에서 infra/docker-compose.local.yml 를 쓰는 경우:
#   KAFKA_BROKERS=<PC_LAN_IP>:9094
#   EC2_API_BASE=http://<PC_LAN_IP>:3000
# (9094=Kafka EXTERNAL, Pi는 이 포트·광고 주소로만 붙어야 함)
KAFKA_BROKERS=myhealth-demo.duckdns.org:9094
EC2_API_BASE=https://overtraining.kro.kr
EDGE_API_KEY=pi-01-initial-key
DEVICE_ID=pi-01
USER_ID=1
MOCK_SENSOR=true
MOCK_FITBIT=true
