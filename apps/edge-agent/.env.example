# Edge Agent (Raspberry Pi) — EC2/운영
# KAFKA: EC2 (EXTERNAL) = EC2_PUBLIC_HOST:9094 , EC2_API_BASE = nginx 공개 https (infra/.env 의 API_BASE_URL)
KAFKA_BROKERS=overtraining.kro.kr:9094
EC2_API_BASE=https://overtraining.kro.kr
EDGE_API_KEY=pi-01-initial-key
DEVICE_ID=pi-01
USER_ID=1
MOCK_SENSOR=true
MOCK_FITBIT=true
